[Unit]
Description=MCP Arrendamento HTTP local
Requires=mcp-arrendamento-display.service
After=mcp-arrendamento-display.service network-online.target
Wants=network-online.target
[Service]
Type=simple
User=marcus
Group=marcus
WorkingDirectory=/home/marcus/apps/mcp-arrendamento
Environment=HOME=/home/marcus
Environment=DISPLAY=:99
Environment=PYTHONPATH=/home/marcus/apps/mcp-arrendamento/src
Environment=ARRENDAMENTO_URL=https://arrendamento.antaq.gov.br
Environment=ARRENDAMENTO_JANELA=visivel
UMask=0077
ExecStart=/home/marcus/apps/mcp-arrendamento/.venv/bin/python -m mcp_arrendamento http
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
