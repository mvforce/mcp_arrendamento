[Unit]
Description=Tela MCP em loopback
Requires=mcp-arrendamento-display.service
After=mcp-arrendamento-display.service
[Service]
Type=simple
User=marcus
Group=marcus
WorkingDirectory=/home/marcus/apps/mcp-arrendamento
Environment=HOME=/home/marcus
Environment=DISPLAY=:99
Environment=PYTHONPATH=/home/marcus/apps/mcp-arrendamento/src
Environment=ARRENDAMENTO_URL=https://arrendamento.antaq.gov.br
Environment=ARRENDAMENTO_JANELA=visivel
UMask=0077
ExecStart=/usr/bin/x11vnc -display :99 -localhost -rfbport 5901 -forever -shared -nopw -noxdamage
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
