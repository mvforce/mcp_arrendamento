[Unit]
Description=noVNC MCP em loopback
Requires=mcp-arrendamento-vnc.service
After=mcp-arrendamento-vnc.service
[Service]
Type=simple
User=marcus
Group=marcus
WorkingDirectory=/home/marcus/apps/mcp-arrendamento
Environment=HOME=/home/marcus
Environment=DISPLAY=:99
Environment=PYTHONPATH=/home/marcus/apps/mcp-arrendamento/src
Environment=ARRENDAMENTO_URL=https://arrendamento.antaq.gov.br
Environment=ARRENDAMENTO_JANELA=visivel
UMask=0077
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5901
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
